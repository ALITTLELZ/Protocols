      "action": "raw",
      "text": "Wrap plate with tin foil and transfer plate to heater-shaker"
    },
    {
      "action": "raw",
      "text": "at 95°C. Incubate for 10 min on heater-shaker."
    },
    {
      "action": "raw",
      "text": "TCEP/CAA can be removed from slot 1"
    },
    {
      "action": "delay",
      "minutes": 10,
      "seconds": 0.0
    },
    {
      "action": "raw",
      "text": "Put plate containing reduced and alkylated samples on ice for 1 min."
    },
    {
      "action": "raw",
      "text": "After cool-down process manually until protease digest."
    },
    {
      "action": "raw",
      "text": "Put S-Trap plate containing sample on slot 3."
    },
