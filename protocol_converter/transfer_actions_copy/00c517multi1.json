      "text": "on slot 2, S-trap plate on slot 3, 12-well reservoir on slot 4,"
    },
    {
      "action": "raw",
      "text": "20 ul tip rack on slot 5 and 300 ul tiprack on slot 6."
    },
    {
      "action": "raw",
      "text": "Make sure the heater-shaker is on slot 10."
