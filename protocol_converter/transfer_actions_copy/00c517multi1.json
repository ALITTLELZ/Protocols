    {
      "action": "raw",
      "text": "Check that all protease solution is at the bottom of the S-trap columns."
    },
    {
      "action": "raw",
      "text": "If not, tap the S-trap plate until all solution is"
    },
    {
      "action": "raw",
      "text": "covering the S-trap material."
    },
    {
      "action": "raw",
      "text": "Incubate S-trap plate with cover"
    },
    {
      "action": "raw",
      "text": "(do not seal tightly!) in incubator at 37°C overnight."
    },
    {
      "action": "raw",
      "text": "Do not shake!"
    },
    {
      "action": "raw",
      "text": "Store leftover trypsin solution at -20°C. After digestion, perform elution"
    },
    {
      "action": "raw",
      "text": "with the TECAN Resolvex A200 or centrifuge."
    },
    {
      "action": "raw",
      "text": "Dry eluted peptides (in 96-well plate) with a vaccuum concentrator."
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "trypsin",
        "targets": "Liquid_1",
        "asp_vol": 125.0,
        "dis_vol": 125.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": {
          "slot": 6,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
