        "asp_flow_rate": 79.68867647058826,
        "dis_flow_rate": 79.68867647058826,
        "tip_racks": [
          {
            "slot": 11,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "A1"
          },
          {
            "slot": 10,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "A1"
          },
          {
            "slot": 11,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "B1"
          },
          {
            "slot": 10,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "B1"
          },
          {
            "slot": 10,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "C1"
          },
          {
            "slot": 11,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "C1"
          }
        ]
      }
    }
  ],
  "reagent": {
    "all_wells": {
      "slot": 1,
      "well": [
        "G10"
