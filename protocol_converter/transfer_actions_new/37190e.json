{
  "description": "This protocol performs a custom cell culture assay on up to 8 flat well plates. Please see these instructions for the exact transfer scheme.",
  "tags": [
    "Sterile Workflows",
    "Cell Culture"
  ],
  "labware": [
    {
      "name": "plate 1 on 1",
      "slot": "1",
      "type": "lab_corning_96_wellplate_360ul_flat"
    },
    {
      "name": "Opentrons 10 Tube Rack with Falcon 4x50 mL, 6x15 mL Conical on 9",
      "slot": "9",
      "type": "lab_opentrons_10_tuberack_falcon_4x50ml_6x15ml_conical"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 10",
      "slot": "10",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 11",
      "slot": "11",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_1",
        "targets": "all_wells",
        "asp_vols": [
          50.0,
          50.0,
          50.0
        ],
        "dis_vols": [
          50.0,
          50.0,
          50.0
        ],
        "asp_flow_rates": [
          92.86,
          92.86,
          92.86
        ],
        "dis_flow_rates": [
          92.86,
          92.86,
          92.86
        ]
      }
    }
  ],
  "reagent": {
    "all_wells": {
      "slot": 1,
      "well": [
        "B5"
      ]
    },
    "Liquid_1": {
      "slot": 9,
      "well": [
        "A2"
      ]
    }
  }
}