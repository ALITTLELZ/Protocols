      "slot": "5",
      "type": "lab_abgene_96_wellplate_330ul_round"
    },
    {
      "name": "plate 5 on 6",
      "slot": "6",
      "type": "lab_abgene_96_wellplate_330ul_round"
    },
    {
      "name": "20µl tiprack on 7",
      "slot": "7",
