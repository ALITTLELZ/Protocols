        10.0,
        10.0
      ],
      "position": {
        "well": "A1",
        "labware": "Diluted RNA plate on Temperature Module GEN2",
        "slot": 7
      },
      "flow_rate": [
        7.6,
        7.6
      ],
      "mix_time": 5
