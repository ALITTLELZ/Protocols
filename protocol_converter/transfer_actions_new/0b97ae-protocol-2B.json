    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mm",
        "targets": "col",
        "asp_vol": 2.5,
        "dis_vol": 2.5,
        "asp_flow_rate": 7.6,
        "dis_flow_rate": 7.6,
        "tip_racks": {
