{
  "description": "This protocol performs a custom sample normalization from a source PCR plate to a second PCR plate, diluting with water from a reservoir. Sample and diluent volumes are specified via .csv file in the following format, including the header line (empty lines ignored):\nsource plate well,destination plate well,volume sample (µl),volume diluent (µl)\nA1, A1, 2, 28\nYou can download an example .csv to edit directly here.\n\n\n\nEppendorf™ 96-Well twin.tec™ PCR Plate 250µl\nNEST 12-channel reservoir 15ml or USA Scientific 12 Well Reservoir 22 mL\nOpentrons 20µl and 300µl tipracks\nOpentrons P20 and P300 GEN2 single-channel pipettes\n\n\n\nNEST 12-channel reservoir (slot 1)\n* channel 1: water for dilution",
  "tags": [
    "Sample Prep",
    "Normalization"
  ],
  "labware": [
    {
      "name": "source plate on Temperature Module GEN2 on 1",
      "slot": "1",
      "type": "lab_regeneron_96_aluminumblock_200ul"
    },
    {
      "name": "destination plate on 2",
      "slot": "2",
      "type": "lab_amplifyt_96_tuberack_200ul"
    },
    {
      "name": "20ul tiprack on 3",
      "slot": "3",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "reservoir for water (position A1) on 5",
      "slot": "5",
      "type": "lab_opentrons_15_tuberack_5000ul"
    },
    {
      "name": "300ul tiprack on 6",
      "slot": "6",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "temperature",
      "target": 4.0
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_1",
        "targets": "d",
        "asp_vol": 101.5,
        "dis_vol": 101.5,
        "asp_flow_rate": 92.86,
        "dis_flow_rate": 92.86,
        "tip_racks": {
          "slot": 6,
          "type": "300ul tiprack",
          "well": "A1"
        }
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_2",
        "targets": "d",
        "asp_vol": 5.0,
        "dis_vol": 5.0,
        "asp_flow_rate": 7.6,
        "dis_flow_rate": 7.6,
        "tip_racks": {
          "slot": 3,
          "type": "20ul tiprack",
          "well": "A1"
        }
      }
    }
  ],
  "reagent": {
    "Liquid_2": {
      "slot": 1,
      "well": [
        "A1"
      ]
    },
    "d": {
      "slot": 2,
      "well": [
        "D1"
      ]
    },
    "Liquid_1": {
      "slot": 5,
      "well": [
        "A1"
      ]
    }
  }
}