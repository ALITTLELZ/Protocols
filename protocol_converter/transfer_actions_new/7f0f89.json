      "name": "Opentrons 96 Tip Rack 300 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "NEST 1 Well Reservoir 195 mL on 9",
      "slot": "9",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "PRCXI_trash"
    }
  ],
