{
  "description": "Since the elution buffer supplied along with PhyTip® Protein A, ProPlus or ProPlus LX Columns is highly acidic (pH 2.5), this protocol (Neutralization) is developed to transfer the neutralization buffer (pH 9.0) to the final product of protein purification (elution plate) to adjust the pH.",
  "tags": [
    "Protein Purification",
    "ProPlus PhyTip® Columns"
  ],
  "labware": [
    {
      "name": "300ul opentrons tiprack on 6",
      "slot": "6",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "elution buffer on 10",
      "slot": "10",
      "type": "lab_opentrons_15_tuberack_nest_15ml_conical"
    },
    {
      "name": "elute plate on 11",
      "slot": "11",
      "type": "lab_thermoscientific_96_wellplate_v_450"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "neutral_buffer",
        "targets": "Liquid_1",
        "asp_vols": [
          180.0
        ],
        "dis_vols": [
          20.0
        ],
        "asp_flow_rates": [
          46.43
        ],
        "dis_flow_rates": [
          46.42999999999996
        ]
      }
    }
  ],
  "reagent": {
    "neutral_buffer": {
      "slot": 10,
      "well": [
        "A5"
      ]
    },
    "Liquid_1": {
      "slot": 11,
      "well": [
        "F6"
      ]
    }
  }
}