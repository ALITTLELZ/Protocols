  "workflow": [
    {
      "action": "delay",
      "minutes": 0,
      "seconds": 10.0
    },
    {
      "action": "temperature",
      "target": 4.0
    },
    {
      "action": "magnet",
      "state": "engage"
    },
    {
      "action": "raw",
      "text": "Ensure reagents in sufficient volume are present on deck."
    },
    {
      "action": "raw",
      "text": "87 uL ENZYME MIX in A1 of Sarstedt 24 well aluminum block with screwcap tube 2 mL on Temperature Module GEN1 on 1"
    },
    {
      "action": "raw",
      "text": "183 uL EP BUFFER AND MIX in A2 of Sarstedt 24 well aluminum block with screwcap tube 2 mL on Temperature Module GEN1 on 1"
    },
    {
      "action": "raw",
      "text": "STEP - transferring enzyme mix to mastermix tube"
    },
    {
      "action": "raw",
      "text": "STEP - transferring EP buffer to mastermix tube and mixing"
    },
    {
      "action": "mix",
      "vol": [
        192.0,
        192.0
      ],
      "position": {
        "well": "A3",
        "labware": "Sarstedt 24 well aluminum block with screwcap tube 2 mL on Temperature Module GEN1",
        "slot": 1
      },
      "flow_rate": [
        94.0,
        94.0
      ],
      "mix_time": 10
