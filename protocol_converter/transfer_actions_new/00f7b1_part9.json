{
  "description": "This protocol adds barcode primers and master mix to samples to prepare for PCR enrichment as outlined in the NEBNext Ultra II Directional RNA Library Prep Kit",
  "tags": [
    "NGS Library Prep",
    "NEBNext Ultra II Directional RNA Library Prep Kit for Illumina"
  ],
  "labware": [
    {
      "name": "Thermo Fisher 96 Well Plate 200 µL on Magnetic Module GEN2 on 1",
      "slot": "1",
      "type": "lab_thermofisher_96_wellplate_200ul"
    },
    {
      "name": "NEB 96 Well Plate 100 µL on 2",
      "slot": "2",
      "type": "lab_neb_96_wellplate_100ul"
    },
    {
      "name": "Opentrons 96 Well Aluminum Block with Generic PCR Strip 200 µL on Temperature Module GEN2 on 3",
      "slot": "3",
      "type": "lab_opentrons_96_aluminumblock_generic_pcr_strip_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 7",
      "slot": "7",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "NEST 1 Well Reservoir 195 mL on 9",
      "slot": "9",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 10",
      "slot": "10",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 11",
      "slot": "11",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "master_mix",
        "targets": "samples",
        "asp_vols": [
          25.0
        ],
        "dis_vols": [
          25.0
        ],
        "asp_flow_rates": [
          47.0
        ],
        "dis_flow_rates": [
          94.0
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "primers",
        "targets": "samples",
        "asp_vols": [
          10.0
        ],
        "dis_vols": [
          10.0
        ],
        "asp_flow_rates": [
          3.8
        ],
        "dis_flow_rates": [
          3.8
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "primers_2",
        "targets": "samples",
        "asp_vols": [
          10.0
        ],
        "dis_vols": [
          10.0
        ],
        "asp_flow_rates": [
          3.8
        ],
        "dis_flow_rates": [
          3.8
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "primers_3",
        "targets": "samples",
        "asp_vols": [
          10.0
        ],
        "dis_vols": [
          10.0
        ],
        "asp_flow_rates": [
          3.8
        ],
        "dis_flow_rates": [
          3.8
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "primers_4",
        "targets": "samples",
