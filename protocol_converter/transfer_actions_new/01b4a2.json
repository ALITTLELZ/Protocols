{
  "description": "This protocol preps up to two 96 well plates with reagent and sample. The protocol takes a csv as input to determine which wells in the middle rack (see below) will be populated. The csv must include the header, with the following order in the header: vial_id, parent_well, dmso_volume, daughter_column. The protocol pauses midway through after the samples are placed and mixed in the middle plates for the user to inspect before resuming.",
  "tags": [
    "Sample Prep",
    "Plate Filling"
  ],
  "labware": [
    {
      "name": "Micronic_M96-4_1.4 96 Well Plate 1400 µL on 3",
      "slot": "3",
      "type": "lab_micronicm9641.4_96_wellplate_1400ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 5",
      "slot": "5",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "Micronic_M96-4_1.4 96 Well Plate 1400 µL on 6",
      "slot": "6",
      "type": "lab_micronicm9641.4_96_wellplate_1400ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 1000 µL on 7",
      "slot": "7",
      "type": "lab_opentrons_96_tiprack_1000ul"
    },
    {
      "name": "Opentrons 6 Tube Rack with VWR 50 mL on 8",
      "slot": "8",
      "type": "lab_opentrons_6_tuberack_50000ul"
    },
    {
      "name": "Bricklabware_type2_rack_short 24 Well Plate 2000 µL on 9",
      "slot": "9",
      "type": "lab_bricklabwaretype2rackshort_24_wellplate_2000ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "mix",
      "vol": [
        500.0,
        500.0
      ],
      "position": {
        "well": "A1",
        "labware": "Bricklabware_type2_rack_short 24 Well Plate 2000 uL",
        "slot": 9
      },
      "flow_rate": [
        274.7,
        274.7
      ],
      "mix_time": 15
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "buff",
        "targets": "source_well",
        "asp_vol": 1000.0,
        "dis_vol": 1000.0,
        "asp_flow_rate": 274.7,
        "dis_flow_rate": 274.7,
        "tip_racks": {
          "slot": 7,
          "type": "Opentrons OT-2 96 Tip Rack 1000 uL",
          "well": "A1"
        }
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "source_well",
        "targets": "source_well",
        "asp_vol": 270.0,
        "dis_vol": 30.0,
        "asp_flow_rate": 92.86,
        "dis_flow_rate": 92.86,
        "tip_racks": {
          "slot": 5,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A1"
        }
      }
    }
  ],
  "reagent": {
    "source_well": {
      "slot": 6,
      "well": [
        "C1"
      ]
    },
    "buff": {
      "slot": 8,
      "well": [
        "A1"
      ]
    }
  }
}