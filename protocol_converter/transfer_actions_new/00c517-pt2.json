        "dis_vol": 50.0,
        "asp_flow_rate": 92.86,
        "dis_flow_rate": 92.86,
        "tip_racks": {
          "slot": 9,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A1"
        }
      }
    }
  ],
  "reagent": {
    "source_well": {
      "slot": 2,
      "well": [
        "A1"
      ],
      "labware": "Agilent 96 Well Plate 500 µL"
    },
    "dest_well": {
      "slot": 3,
      "well": [
        "A1"
      ],
      "labware": "Agilent 96 Well Plate 1400 µL"
    }
  }
