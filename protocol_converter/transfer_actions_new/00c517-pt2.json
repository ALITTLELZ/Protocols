{
  "description": "This protocol fills sds (slot 4) and sample (slot 2) according to a user specified csv.",
  "tags": [
    "00c517-pt2.ot2.apiv2.py",
    "Sample Prep",
    "Plate Filling"
  ],
  "workflow": [
    {
      "action": "mix",
      "vol": [
        32.0,
        32.0
      ],
      "position": {
        "well": "A1",
