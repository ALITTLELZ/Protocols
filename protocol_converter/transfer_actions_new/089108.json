      "text": "Return plate to slot 2."
    },
    {
      "action": "raw",
      "text": "Remove trough in slot 11 (195ml 1well) with Buffer A1."
    },
    {
      "action": "raw",
      "text": "Exchange with a new trough with Buffer A2 in Slot 1."
    },
    {
      "action": "raw",
      "text": "Select \"Resume\" on the Opentrons app."
