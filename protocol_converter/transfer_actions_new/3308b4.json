{
  "description": "This is a specific protocol for aliquoting liquid from three reagent plates to three 96 deep well plates using a multi-channel p300 pipette. Tips are changed between reagents. Either pipette mount can be specified in setup.\n 350ul SPR Wash Buffer is added to a 96 deep well plate\n 350ul VHB Buffer is added to a second 96 deep well plate\n* 50ul nuclease free water is added to a third 96 deep well plate\n\n'P300-Multi Mount Side': Left or right refers to the pipette mount side",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 1",
      "slot": "1",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "NEST 1 Well Reservoir 195 mL on 4",
      "slot": "4",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "NEST 1 Well Reservoir 195 mL on 5",
      "slot": "5",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "NEST 1 Well Reservoir 195 mL on 6",
      "slot": "6",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "NEST 96 Deepwell Plate 2mL on 7",
      "slot": "7",
      "type": "lab_nest_96_wellplate_2ml_deep"
    },
    {
      "name": "NEST 96 Deepwell Plate 2mL on 8",
      "slot": "8",
      "type": "lab_nest_96_wellplate_2ml_deep"
    },
    {
      "name": "NEST 96 Deepwell Plate 2mL on 9",
      "slot": "9",
      "type": "lab_nest_96_wellplate_2ml_deep"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "source_list",
        "targets": "Liquid_1",
        "asp_vol": 175.0,
        "dis_vol": 175.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": {
          "slot": 1,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A1"
        }
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "source_list_2",
        "targets": "Liquid_2",
        "asp_vol": 175.0,
        "dis_vol": 175.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": {
          "slot": 1,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A2"
        }
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "source_list_3",
        "targets": "dests",
        "asp_vol": 50.0,
        "dis_vol": 50.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": {
          "slot": 1,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A3"
        }
      }
    }
  ],
  "reagent": {
    "source_list": {
      "slot": 4,
      "well": [
        "A1"
      ]
    },
    "source_list_2": {
      "slot": 5,
      "well": [
        "A1"
      ]
    },
    "source_list_3": {
      "slot": 6,
      "well": [
        "A1"
      ]
    },
    "Liquid_1": {
      "slot": 7,
      "well": [
        "A12"
      ]
    },
    "Liquid_2": {
      "slot": 8,
      "well": [
        "A12"
      ]
    },
    "dests": {
      "slot": 9,
      "well": [
        "A3"
      ]
    }
  }
}