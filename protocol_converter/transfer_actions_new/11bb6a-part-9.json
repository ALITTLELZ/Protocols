{
  "description": "This protocol uses multi-channel P20 and P300 pipettes to perform fragment analyzer set up steps on 48-96 output libraries. User-determined parameters are available for selection of the labware for the libraries plate.\nLinks:\n Part 1: Enzymatic Fragmentation and End Prep\n Part 2: Sample Cleanup for Covaris Samples\n Part 3: End Prep\n Part 4: Adapter Ligation\n Part 5: Size Selection\n Part 6: Clean Up\n Part 7: PCR Enrichment\n Part 8: Sample Clean Up\n Part 9: Fragment Analyzer\n Part 10: Pooling According to Concentration",
  "tags": [
    "NGS Library Prep",
    "NEBNext"
  ],
  "labware": [
    {
      "name": "Libraries Plate on 3",
      "slot": "3",
      "type": "lab_vwr_96well_pcr_plate_200ul"
    },
    {
      "name": "12-well Reservoir on 5",
      "slot": "5",
      "type": "lab_nest_12_reservoir_15ml"
    },
    {
      "name": "Fragment Analyzer Plate on 6",
      "slot": "6",
      "type": "lab_biorad_96_fragment_analyzer_plate_aluminumblock_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 7",
      "slot": "7",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 10",
      "slot": "10",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "delay",
      "minutes": 0,
      "seconds": 10.0
    },
    {
      "action": "magnet",
      "state": "disengage"
    },
    {
      "action": "raw",
      "text": "Ensure reagents in sufficient volume are present on deck"
    },
    {
      "action": "raw",
      "text": "4 mL DILUENT BUFFER in A9 of 12-well Reservoir on 5"
    },
    {
      "action": "raw",
      "text": "Step - diluent bf to fragment analyzer plate (all wells except H12)"
    },
    {
      "action": "raw",
      "text": "Step - 2 uL library sample to fragment analyzer plate"
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "location",
        "targets": "Liquid_1",
        "asp_vol": 22.0,
        "dis_vol": 22.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": [
          {
            "slot": 7,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "A1"
          },
          {
            "slot": 7,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "B2"
          }
        ]
      }
    },
    {
      "action": "raw",
      "text": "Finished. Proceed to measure concentration."
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_2",
        "targets": "Liquid_1",
        "asp_vol": 2.0,
        "dis_vol": 2.0,
        "asp_flow_rate": 7.599999999999999,
        "dis_flow_rate": 7.599999999999999,
        "tip_racks": [
          {
