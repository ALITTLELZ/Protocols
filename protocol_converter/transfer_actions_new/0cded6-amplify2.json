    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mag_samples",
        "targets": "Liquid_1",
        "asp_vol": 55.0,
        "dis_vol": 55.0,
        "asp_flow_rate": 10.160000000000002,
        "dis_flow_rate": 50.8,
        "tip_racks": [
          {
            "slot": 9,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "A1"
          },
          {
            "slot": 9,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "A2"
          },
          {
            "slot": 3,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "A1"
          },
          {
            "slot": 3,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "A2"
          }
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mm",
        "targets": "mag_samples",
        "asp_vol": 40.0,
        "dis_vol": 40.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": [
          {
            "slot": 9,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
