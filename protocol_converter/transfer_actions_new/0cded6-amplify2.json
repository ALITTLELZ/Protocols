      "name": "Opentrons 96 Filter Tip Rack 20 µL on 3",
      "slot": "3",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "reagent plate on Temperature Module GEN2 on 4",
      "slot": "4",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "index adapter plate on 5",
      "slot": "5",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "TAG1 plate on Magnetic Module GEN2 on 7",
      "slot": "7",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "reagent reservoir on 8",
