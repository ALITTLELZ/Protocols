{
  "description": "This protocol performs transfers of reagents for the Promega ADP-Glo Kinase Assay. It will transfer four different liquids into the test wells with pauses for centrifugation and incubations in between transfers.\n\n\n\nP20 single-channel GEN2 electronic pipette\nGreiner Microplate 384 Wells\n\n\n\nDeck Setup\n Greiner 384 Well Plate (Slot 1)\n Opentrons 20uL Tips (Slot 2)\n* Opentrons 24 Tube Rack 1.5mL Tubes (Slot 4)\nReagent Setup: Opentrons 24 Tube Rack 1.5mL Tubes (Slot 4):\n Liquid A (A1)\n Liquid B (B1)\n Liquid C (C1)\n Liquid D (D1)",
  "tags": [
    "Sample Prep",
    "Plate Filling"
  ],
  "labware": [
    {
      "name": "Greiner 384 Well Plate 130 µL on 1",
      "slot": "1",
      "type": "lab_greiner_384_wellplate_130ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 2",
      "slot": "2",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Opentrons 24 Tube Rack with Eppendorf 1.5 mL Safe-Lock Snapcap on 4",
      "slot": "4",
      "type": "lab_opentrons_24_tuberack_eppendorf_1point5ml_safelock_snapcap"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "liquid_A",
        "targets": "sample_wells",
        "asp_vol": 4.75,
        "dis_vol": 4.75,
        "asp_flow_rate": 7.559999999999975,
        "dis_flow_rate": 7.559999999999975,
        "tip_racks": [
          {
            "slot": 2,
            "type": "Opentrons OT-2 96 Tip Rack 20 uL",
            "well": "A1"
          },
          {
            "slot": 2,
            "type": "Opentrons OT-2 96 Tip Rack 20 uL",
            "well": "B1"
          },
          {
            "slot": 2,
            "type": "Opentrons OT-2 96 Tip Rack 20 uL",
            "well": "C1"
          },
          {
            "slot": 2,
            "type": "Opentrons OT-2 96 Tip Rack 20 uL",
            "well": "D1"
          }
        ]
      }
    }
  ],
  "reagent": {
    "sample_wells": {
      "slot": 1,
      "well": [
        "C24"
      ]
    },
    "liquid_A": {
      "slot": 4,
      "well": [
        "A1"
      ]
    }
  }
}