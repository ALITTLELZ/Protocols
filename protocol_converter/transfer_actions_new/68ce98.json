{
  "description": "This protocol performs the transfer of samples and reagent from one plate to another. It will pre-wet the tip and aspirate/dispense 300uL 3 times. Then it will transfer 750 uL to a second plate with a 30uL air gap, blow out and touch tip at the destination.\n\n\n\nP300 multi-channel GEN2 electronic pipette\nWaters 2mL 96 Well Plate",
  "tags": [
    "Sample Prep",
    "Plate Filling"
  ],
  "labware": [
    {
      "name": "Plate 1 on 1",
      "slot": "1",
      "type": "lab_waters_96_wellplate_2ml"
    },
    {
      "name": "Plate 2 on 2",
      "slot": "2",
      "type": "lab_waters_96_wellplate_2ml"
    },
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 4",
      "slot": "4",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "PRCXI_trash"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "plate1_wells",
        "targets": "plate2_wells",
        "asp_vols": [
          140.0
        ],
        "dis_vols": [
          280.0
        ],
        "asp_flow_rates": [
          100.0
        ],
        "dis_flow_rates": [
          100.0
        ]
      }
    }
  ],
  "reagent": {
    "plate1_wells": {
      "slot": 1,
      "well": [
        "A6"
      ]
    },
    "plate2_wells": {
      "slot": 2,
      "well": [
        "A3"
      ]
    }
  }
}