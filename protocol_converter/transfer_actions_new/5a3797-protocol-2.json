{
  "description": "This protocol performs the transfer of mastermix and samples from a source to a destination PCR plate.",
  "tags": [
    "5a3797-protocol-2.ot2.apiv2.py",
    "PCR",
    "PCR Prep"
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mastermix",
        "targets": "Liquid_1",
        "asp_vol": 15.0,
        "dis_vol": 15.0,
        "asp_flow_rate": 7.599999999999999,
        "dis_flow_rate": 7.599999999999999,
        "tip_racks": {
          "slot": 1,
          "type": "Tip Box 1",
          "well": "A1"
        }
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_2",
        "targets": "Liquid_1",
        "asp_vol": 10.0,
        "dis_vol": 10.0,
        "asp_flow_rate": 7.599999999999999,
        "dis_flow_rate": 7.599999999999999,
        "tip_racks": [
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A1"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A2"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A3"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A4"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A5"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A6"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A7"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A8"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A9"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A10"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A11"
          },
          {
            "slot": 2,
            "type": "Tip Box 2",
            "well": "A12"
          }
        ]
      }
    }
  ],
  "reagent": {
    "Liquid_2": {
      "slot": 4,
      "well": [
        "A5"
      ],
      "labware": "KingFisher 96 Deep Well Plate"
    },
    "Liquid_1": {
      "slot": 5,
      "well": [
        "A10"
      ],
      "labware": "ThermoFisher MicroAmp Fast 96-well 0.1 96 Well Plate 100 µL"
    },
    "mastermix": {
      "slot": 7,
      "well": [
        "A1"
      ],
      "labware": "MicroAmp 96-Well Base with 0.2 mL Thermo Scientific PCR Tube Strip"
    }
  }
}