{
  "description": "This protocol performs the transfer of mastermix and samples from a source to a destination PCR plate.",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "Tip Box 1 on 1",
      "slot": "1",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Tip Box 2 on 2",
      "slot": "2",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "KingFisher 96 Deep Well Plate on 4",
      "slot": "4",
      "type": "lab_kingfisher_96_deepwell_plate_2ml"
    },
    {
      "name": "ThermoFisher MicroAmp Fast 96-well 0.1 96 Well Plate 100 µL on 5",
      "slot": "5",
      "type": "lab_thermofishermicroampfast96well0point1_96_wellplate_100ul"
    },
    {
      "name": "MicroAmp 96-Well Base with 0.2 mL Thermo Scientific PCR Tube Strip on 7",
      "slot": "7",
      "type": "lab_96well_pcr_base_200ul_strip"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "PRCXI_trash"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mastermix",
        "targets": "Liquid_1",
        "asp_vols": [
          15.0
        ],
        "dis_vols": [
          15.0
        ],
        "asp_flow_rates": [
          7.599999999999999
        ],
        "dis_flow_rates": [
          7.599999999999999
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_2",
        "targets": "Liquid_1",
        "asp_vols": [
          10.0
        ],
        "dis_vols": [
          10.0
        ],
        "asp_flow_rates": [
          7.599999999999999
        ],
        "dis_flow_rates": [
          7.599999999999999
        ]
      }
    }
  ],
  "reagent": {
    "Liquid_2": {
      "slot": 4,
      "well": [
        "A9"
      ]
    },
    "Liquid_1": {
      "slot": 5,
      "well": [
        "A2"
      ]
    },
    "mastermix": {
      "slot": 7,
      "well": [
        "A1"
      ]
    }
  }
}