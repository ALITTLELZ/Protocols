{
  "description": "This protocol automates the transfer of rehydration buffer, samples, positive control, and negative control from the CerTest VIASURE SARS-CoV-2 Real Time PCR Detection kit into a PCR plate. It requires a 96 deep well plate of samples (1-94), the positive and negative control tubes in a tube rack, and a new PCR plate. This protocol uses exactly 2 tip racks and takes advantage of manually programmed multichannel transfers so that it only requires a p20 multichannel pipette. \n\n\n\nOpentrons P20-multi channel electronic pipette (GEN2)\nOpentrons 20ul Filter Tips\nNEST 1 Well Reservoir 195 mL\nNEST 0.1 mL 96-Well PCR Plate, Full Skirt\nVIASURE SARS-CoV-2 Real Time PCR Detection Kit",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "NEST 1 Well Reservoir 195 mL on 3",
      "slot": "3",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 4",
      "slot": "4",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "NEST 96 Well Plate 100 µL PCR Full Skirt on 5",
      "slot": "5",
      "type": "lab_nest_96_wellplate_100ul_pcr_full_skirt"
    },
    {
      "name": "NEST 96 Deepwell Plate 2mL on 6",
      "slot": "6",
      "type": "lab_nest_96_wellplate_2ml_deep"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 7",
      "slot": "7",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons 24 Tube Rack with Eppendorf 1.5 mL Safe-Lock Snapcap on 8",
      "slot": "8",
      "type": "lab_opentrons_24_tuberack_eppendorf_1point5ml_safelock_snapcap"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "rehydration_buffer",
        "targets": "Liquid_1",
        "asp_vols": [
          15.0
        ],
        "dis_vols": [
          15.0,
          15.0
        ],
        "asp_flow_rates": [
          7.599999999999999
        ],
        "dis_flow_rates": [
          7.599999999999999,
          7.599999999999999
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_2",
        "targets": "Liquid_1",
        "asp_vols": [
          5.0
        ],
        "dis_vols": [
          5.0,
          5.0
        ],
        "asp_flow_rates": [
          7.599999999999999
        ],
        "dis_flow_rates": [
          7.599999999999999,
          7.599999999999999
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "neg_ctrl",
        "targets": "Liquid_3",
        "asp_vols": [
          5.0
        ],
        "dis_vols": [
          5.0,
          5.0
        ],
        "asp_flow_rates": [
          7.6
        ],
        "dis_flow_rates": [
          7.6,
          7.6
        ]
      }
    }
  ],
  "reagent": {
    "rehydration_buffer": {
      "slot": 3,
      "well": [
        "A1"
      ]
    },
    "Liquid_1": {
      "slot": 5,
      "well": [
        "A7",
        "H12"
      ]
    },
    "Liquid_3": {
      "slot": 5,
      "well": [
        "A7",
        "H12"
      ]
    },
    "Liquid_2": {
      "slot": 6,
      "well": [
        "A1"
      ]
    },
    "neg_ctrl": {
      "slot": 8,
      "well": [
        "B1"
      ]
    }
  }
}