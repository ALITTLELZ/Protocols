{
  "description": "This protocol is part 1 of a 3 part series which preps a 96 well Bio-Rad 200ul plate with diluted DNA and mastermix in accordance with the Ilumina DNA Prep Kit. DNA is diluted with water before mastermix is added. Find part 2 and part 3 of protocol below:\n\nPart 2: Post Tagmentation Cleanup\nPart 3: Cleanup libraries\n\nExplanation of complex parameters below:\n Number of samples: Specify the number of samples for this run.\n P300 Tip Start Column on Slot 8 (1-12): One column of the 200ul tip rack will be used per run. Specify which column to pick up tips from for this run.\n P20 Multi-Channel GEN2 Mount: Specify which side (left or right) the P20 multi channel pipette is mounted.\n P300 Multi Channel GEN2 Mount: Specify which side (left or right) the P300 multi channel pipette is mounted.",
  "tags": [
    "0bf4f4.ot2.apiv2.py",
    "NGS Library Prep",
    "Illumina DNA Prep"
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "water",
        "targets": "dest",
        "asp_vol": 10.0,
        "dis_vol": 10.0,
        "asp_flow_rate": 7.6,
        "dis_flow_rate": 7.6,
        "tip_racks": {
          "slot": 5,
          "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
          "well": "A1"
        }
      }
    },
    {
      "action": "mix",
      "vol": [
        15.0,
        15.0
      ],
      "position": {
        "well": "A1",
        "labware": "Sample Plate",
        "slot": 2
      },
      "flow_rate": [
        7.6,
        7.6
      ],
      "mix_time": 10
    },
    {
      "action": "mix",
      "vol": [
        12.0,
        12.0
      ],
      "position": {
        "well": "A1",
        "labware": "Final Plate",
        "slot": 3
      },
      "flow_rate": [
        7.6,
        7.6
      ],
      "mix_time": 10
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "dna",
        "targets": "dest",
        "asp_vol": 5.0,
        "dis_vol": 5.0,
        "asp_flow_rate": 7.6,
        "dis_flow_rate": 7.6,
        "tip_racks": {
          "slot": 5,
          "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
          "well": "A2"
        }
      }
    },
    {
      "action": "mix",
      "vol": [
        80.0,
        80.0
      ],
      "position": {
        "well": "A1",
        "labware": "Mastermix Plate",
        "slot": 1
      },
      "flow_rate": [
        94.0,
        94.0
      ],
      "mix_time": 15
    },
    {
      "action": "delay",
      "minutes": 0,
      "seconds": 1.5
    },
    {
      "action": "mix",
      "vol": [
        18.0,
        18.0
      ],
      "position": {
        "well": "A1",
        "labware": "Final Plate",
        "slot": 3
      },
      "flow_rate": [
        4.0,
        4.0
      ],
      "mix_time": 15
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mastermix",
        "targets": "dest",
        "asp_vol": 10.0,
        "dis_vol": 10.0,
        "asp_flow_rate": 4.0,
        "dis_flow_rate": 4.0,
        "tip_racks": [
          {
            "slot": 8,
            "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
            "well": "A1"
          },
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "A3"
          }
        ]
      }
    }
  ],
  "reagent": {
    "mastermix": {
      "slot": 1,
      "well": [
        "A1"
      ],
      "labware": "Mastermix Plate"
    },
    "dna": {
      "slot": 2,
      "well": [
        "A1"
      ],
      "labware": "Sample Plate"
    },
    "dest": {
      "slot": 3,
      "well": [
        "A1"
      ],
      "labware": "Final Plate"
    },
    "water": {
      "slot": 4,
      "well": [
        "A1"
      ],
      "labware": "NEST 12 Well Reservoir 15 mL"
    }
  }
}