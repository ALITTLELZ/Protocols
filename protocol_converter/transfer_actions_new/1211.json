    },
    "Liquid_5": {
      "slot": 3,
      "well": [
        "A1"
      ],
      "labware": "NEST 1 Well Reservoir 195 mL"
    },
    "Liquid_2": {
      "slot": 4,
      "well": [
        "A11"
      ],
