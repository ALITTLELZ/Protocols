{
  "description": "This protocol automates the pooling of 20 ul aliquots taken from designated wells of a 2 mL 96-well plate and dispensed into a single tube.\nOnly the rear-most channel of the p300 multichannel pipette is used.\n\nTo purchase tips, reagents, or pipettes, please visit our online store or contact our sales team at info@opentrons.com\n\nOpentrons OT-2\nOpentrons OT-2 Run App (Version 3.19.0 or later)\nOpentrons Multi-Channel p300 pipette\nOpentrons Tips for the p300 pipette",
  "tags": [
    "Sample Prep",
    "Pooling"
  ],
  "labware": [
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 4",
      "slot": "4",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "NEST 96 Deepwell Plate 2mL on 5",
      "slot": "5",
      "type": "lab_nest_96_wellplate_2ml_deep"
    },
    {
      "name": "LVL Technologies 48 Well Plate 2000 µL on 6",
      "slot": "6",
      "type": "lab_lvltechnologies_48_wellplate_2000ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "delay",
      "minutes": 0,
      "seconds": 10.0
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_1",
        "targets": "pool",
        "asp_vol": 20.0,
        "dis_vol": 20.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": [
          {
            "slot": 4,
            "type": "Opentrons OT-2 96 Tip Rack 300 uL",
            "well": "H1"
          },
          {
            "slot": 4,
            "type": "Opentrons OT-2 96 Tip Rack 300 uL",
            "well": "H2"
          },
          {
            "slot": 4,
            "type": "Opentrons OT-2 96 Tip Rack 300 uL",
            "well": "H3"
          },
          {
            "slot": 4,
            "type": "Opentrons OT-2 96 Tip Rack 300 uL",
            "well": "H4"
          },
          {
            "slot": 4,
            "type": "Opentrons OT-2 96 Tip Rack 300 uL",
            "well": "H5"
          }
        ]
      }
    }
  ],
  "reagent": {
    "Liquid_1": {
      "slot": 5,
      "well": [
        "G3"
      ]
    },
    "pool": {
      "slot": 6,
      "well": [
        "A1"
      ]
    }
  }
}