      "slot": "2",
      "type": "lab_nest_12_reservoir_15ml"
    },
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 3",
      "slot": "3",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "Opentrons 24 Well Aluminum Block with NEST 1.5 mL Snapcap on 4",
      "slot": "4",
      "type": "lab_opentrons_24_aluminumblock_nest_1.5ml_snapcap"
    },
    {
      "name": "dilution plate on 5",
      "slot": "5",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
