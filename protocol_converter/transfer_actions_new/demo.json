    {
      "action": "raw",
      "text": "Pauses can be put at any point during a protocol"
    },
    {
      "action": "raw",
      "text": "to replace plates, reagents, spin down plates,"
    },
    {
      "action": "raw",
      "text": "or for any other instance where human intervention"
    },
    {
      "action": "raw",
      "text": "is needed. Protocols continue after a `Pause` when"
