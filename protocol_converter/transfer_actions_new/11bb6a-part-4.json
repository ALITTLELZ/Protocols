{
  "description": "This protocol uses multi-channel P20 and P300 pipettes to perform adapter ligation steps on 48-96 input samples. User-determined parameters are available for selection of the labware for the library prep plate, the reagent plate, and the labware for reagent tubes on the temperature module.\nLinks:\n Part 1: Enzymatic Fragmentation and End Prep\n Part 2: Sample Cleanup for Covaris Samples\n Part 3: End Prep\n Part 4: Adapter Ligation\n Part 5: Size Selection\n Part 6: Clean Up\n Part 7: PCR Enrichment\n Part 8: Sample Clean Up\n Part 9: Fragment Analyzer\n Part 10: Pooling According to Concentration",
  "tags": [
    "NGS Library Prep",
    "NEBNext"
  ],
  "labware": [
    {
      "name": "Sarstedt 24 well aluminum block with screwcap tube 2 mL on Temperature Module GEN1 on 1",
      "slot": "1",
      "type": "lab_sarstedt_24_aluminumblock_screwcap_tube_2ml"
    },
    {
      "name": "Library Prep Plate on 3",
      "slot": "3",
      "type": "lab_vwr_96well_pcr_plate_200ul"
    },
    {
      "name": "Reagent Plate on 6",
      "slot": "6",
      "type": "lab_vwr_96well_pcr_plate_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 7",
      "slot": "7",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 8",
      "slot": "8",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 10",
      "slot": "10",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 11",
      "slot": "11",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
