{
  "description": "This protocol performs a PCR plating and PCR reaction on the Opentrons Thermocycler Module. The worklist input for where to transfer oligos should be specified in the following format, including header line:\nPipettor,Slot 5 well (Oligo source plate),Slot 10 well (Destination plate),Volume uL\nP20 single channel,A6,A1,10\nP20 single channel,C1,A1,10\nP20 single channel,A1,B1,10\nP20 single channel,A7,B1,2.5\nP20 single channel,A8,B1,2.5\nP20 single channel,A9,B1,2.5\n...\nYou can download a template .csv file here.",
  "tags": [
    "PCR",
    "Complete PCR Workflow"
  ],
  "labware": [
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 1",
      "slot": "1",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "oligo source plate 2 on 2",
      "slot": "2",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "reagent plate on 4",
      "slot": "4",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "oligo source plate 1 on 5",
      "slot": "5",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "pcr plate on Thermocycler Module on 7",
      "slot": "7",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 9",
      "slot": "9",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "oligo_sources",
        "targets": "oligo_dests",
        "asp_vols": [
          4.545454545454546
        ],
        "dis_vols": [
          4.545454545454546
        ],
        "asp_flow_rates": [
          7.560000000000001
        ],
        "dis_flow_rates": [
          7.560000000000001
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "pcr_reagent",
        "targets": "oligo_dests",
        "asp_vols": [
          30.0
        ],
        "dis_vols": [
          30.0
        ],
        "asp_flow_rates": [
          94.0
        ],
        "dis_flow_rates": [
          94.0
        ]
      }
    }
  ],
  "reagent": {
    "pcr_reagent": {
      "slot": 4,
      "well": [
        "A1"
      ]
    },
    "oligo_sources": {
      "slot": 5,
      "well": [
        "B6"
      ]
    },
    "oligo_dests": {
      "slot": 7,
      "well": [
        "C1"
      ]
    }
  }
}