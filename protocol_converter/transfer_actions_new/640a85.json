{
  "description": "This protocol performs a custom PCR preparation on DNA samples in triplicate using pre-created mastermix.\nDNA samples should be arranged down columns before moving across rows (sample 1 in plate well A1, sample 2 in plate well B1, ..., sample 9 in plate well A2, etc.).\n\n\n\nThermo Scientific semi-skirted 96-well PCR plate 300ul #AB1400150\nNEST 12-channel reservoir 15ml #360102\nOpentrons P300 multi-channel electronic pipette\nOpentrons P20 single-channel GEN2 electronic pipette\nOpentrons 10/20ul and 50/300ul tipracks",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "300ul tips on 1",
      "slot": "1",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "20ul tips on 2",
      "slot": "2",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "input DNA sample plate on 4",
      "slot": "4",
      "type": "lab_thermoscientific_96_wellplate_300ul"
    },
    {
      "name": "reservoir for mastermix on 6",
      "slot": "6",
      "type": "lab_nest_12_reservoir_15ml"
    },
    {
      "name": "Thermo Scientific 96 Well Plate 300 µL on Thermocycler Module on 7",
      "slot": "7",
      "type": "lab_thermoscientific_96_wellplate_300ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
