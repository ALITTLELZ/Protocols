      "action": "raw",
      "text": "Opening Thermocycler lid"
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mm",
        "targets": "tc_dests",
        "asp_vol": 41.5,
        "dis_vol": 83.0,
        "asp_flow_rate": 150.0,
        "dis_flow_rate": 300.0,
        "tip_racks": {
          "slot": 1,
          "type": "300ul tips",
          "well": "A1"
        }
      }
    },
    {
      "action": "mix",
      "vol": [
        7.0,
        10.0
