{
  "description": "This protocol performs a custom NGS Library Prep. It utilizes two temperature modules in Slot 1 and Slot 3 for the cooling of reagents. It also utilizes the magnetic module for bead based purification of samples.\nExplanation of complex parameters below:\n P20 Multichannel GEN2 Mount Position: Choose the mount position of the P20 Multichannel GEN2 pipette.\n P300 Multichannel GEN2 Mount Position: Choose the mount position of the P300 Multichannel GEN2 pipette.\n* Number of Samples: Enter total number of samples in the protocol run. Note: Because both pipettes are 8-channels, the number of samples should be a multiple of 8, otherwise it will use up additional tips for an entire column.",
  "tags": [
    "NGS Library Prep",
    "Custom"
  ],
  "labware": [
    {
      "name": "NEST 12 Well Reservoir 15 mL on Temperature Module GEN2 on 1",
      "slot": "1",
      "type": "lab_nest_12_reservoir_15ml"
    },
    {
      "name": "Bio-Rad 96 Well Plate 200 µL PCR on 2",
      "slot": "2",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "Bio-Rad 96 Well Plate 200 µL PCR on Temperature Module GEN2 on 3",
      "slot": "3",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "Bio-Rad 96 Well Plate 200 µL PCR on Magnetic Module GEN2 on 4",
      "slot": "4",
      "type": "lab_biorad_96_wellplate_200ul_pcr"
    },
    {
      "name": "NEST 1 Well Reservoir 195 mL on 6",
      "slot": "6",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 7",
      "slot": "7",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 8",
      "slot": "8",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 10",
      "slot": "10",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 11",
      "slot": "11",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
