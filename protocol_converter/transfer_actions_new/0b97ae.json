{
  "description": "With this Protocol you can Normalize RNA samples using RNA Concentration, Goal Concentration, Total Volume. This Normalization is the normalization protocol to preceed the QIAseq FastSelect and QIAsec FastSelect 5s , 16S and 23S.",
  "tags": [
    "SAMPLE PREP",
    "Normalization"
  ],
  "labware": [
    {
      "name": "Water reservoir on 2",
      "slot": "2",
      "type": "lab_perkinelmer_12_reservoir_21000ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 3",
      "slot": "3",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 5",
      "slot": "5",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Dilution plate on Temperature Module GEN2 on 7",
      "slot": "7",
      "type": "lab_appliedbiosystemsenduraplate_96_aluminumblock_220ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 8",
      "slot": "8",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "source RNA plate on Temperature Module GEN2 on 10",
      "slot": "10",
      "type": "lab_opentrons_96_aluminumblock_biorad_wellplate_200ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "temperature",
      "target": 4.0
    },
    {
      "action": "temperature",
      "target": 4.0
    },
    {
      "action": "mix",
      "vol": [
        10.0,
        10.0
      ],
      "position": {
        "well": "A1",
        "labware": "Dilution plate on Temperature Module GEN2",
        "slot": 7
      },
      "flow_rate": [
        7.56,
        7.56
      ],
      "mix_time": 5
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "source_well",
        "targets": "destination_well",
        "asp_vol": 5.7,
        "dis_vol": 5.7,
        "asp_flow_rate": 7.56,
        "dis_flow_rate": 7.56,
        "tip_racks": {
          "slot": 3,
          "type": "Opentrons OT-2 96 Tip Rack 20 uL",
          "well": "B1"
        }
      }
    },
    {
      "action": "temperature",
      "state": "off"
    },
    {
      "action": "temperature",
      "state": "off"
    },
    {
      "action": "raw",
      "text": "Process Complete."
    }
  ],
  "reagent": {
    "destination_well": {
      "slot": 7,
      "well": [
        "A1"
      ]
    },
    "source_well": {
      "slot": 10,
      "well": [
        "A1"
      ]
    }
  }
}