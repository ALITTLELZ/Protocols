{
  "description": "This is a custom PCR prep protocol that transfers up to 24 RNA samples to 4 different mastermixes. The transfer scheme can be shown on the deck layout below.",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "mastermix tuberack (column 1) on 2",
      "slot": "2",
      "type": "lab_opentrons_24_tuberack_eppendorf_1point5ml_safelock_snapcap"
    },
    {
      "name": "Opentrons 96 Tip Rack 10 µL on 3",
      "slot": "3",
      "type": "lab_opentrons_96_tiprack_10ul"
    },
    {
      "name": "PCR plate on Temperature Module GEN1 on 4",
      "slot": "4",
      "type": "lab_opentrons_96_aluminumblock_biorad_wellplate_200ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 10 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_tiprack_10ul"
    },
    {
      "name": "sample plate on Temperature Module GEN1 on 7",
      "slot": "7",
      "type": "lab_opentrons_96_aluminumblock_biorad_wellplate_200ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mms",
        "targets": "wells_row_order",
        "asp_vols": [
          8.0,
          8.0,
          8.0,
          8.0
        ],
        "dis_vols": [
          8.0,
          8.0,
          8.0,
          8.0
        ],
        "asp_flow_rates": [
          5.0,
          5.0,
          5.0,
          5.0
        ],
        "dis_flow_rates": [
          10.0,
          10.0,
          10.0,
          10.0
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "samples",
        "targets": "wells_row_order",
        "asp_vols": [
          2.0,
          2.0,
          2.0
        ],
        "dis_vols": [
          2.0,
          2.0,
          2.0
        ],
        "asp_flow_rates": [
          5.0,
          5.0,
          5.0
        ],
        "dis_flow_rates": [
          10.0,
          10.0,
          10.0
        ]
      }
    }
  ],
  "reagent": {
    "mms": {
      "slot": 2,
      "well": [
        "A1"
      ]
    },
    "wells_row_order": {
      "slot": 4,
      "well": [
        "F4"
      ]
    },
    "samples": {
      "slot": 7,
      "well": [
        "A1"
      ]
    }
  }
}