{
  "description": "This is a flexible protocol that helps you to prepare the PCR plate for a batch test of 12 samples and 2 No Template Controls, with the previous adition of the Master Mix\nThe protocol is broken down into 3 main parts:\n Mix dispensing\n Samples Dispensing\n* NTC dispensing",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "Opentrons 24 Tube Rack with Generic 2 mL Screwcap on 1",
      "slot": "1",
      "type": "lab_opentrons_24_tuberack_generic_2ml_screwcap"
    },
    {
      "name": "NEST 96 Well Plate 100 µL PCR Full Skirt on 2",
      "slot": "2",
      "type": "lab_nest_96_wellplate_100ul_pcr_full_skirt"
    },
    {
      "name": "Temperature-Controlled Tubes on Temperature Module GEN2 on 3",
      "slot": "3",
      "type": "lab_opentrons_24_aluminumblock_generic_2ml_screwcap"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 5",
      "slot": "5",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "temperature",
      "target": 8.0
    },
    {
      "action": "raw",
      "text": "Waiting for Temperature Module to reach temperature 8.0 °C (rounded off to nearest integer)"
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "MIX",
        "targets": "Liquid_1",
        "asp_vol": 16.0,
        "dis_vol": 7.5,
        "asp_flow_rate": 7.5600000000000005,
        "dis_flow_rate": 7.560000000000001,
        "tip_racks": {
          "slot": 5,
          "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
          "well": "A1"
        }
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "muestra_MH1",
        "targets": "Liquid_1",
        "asp_vol": 6.0,
        "dis_vol": 2.5,
        "asp_flow_rate": 7.5600000000000005,
        "dis_flow_rate": 7.560000000000001,
        "tip_racks": [
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "B1"
          },
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "C1"
          },
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "D1"
          },
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "E1"
          },
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "F1"
          },
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "G1"
          },
          {
            "slot": 5,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "H1"
          }
        ]
      }
    }
  ],
  "reagent": {
    "muestra_MH1": {
      "slot": 1,
      "well": [
        "C1"
      ]
    },
    "Liquid_1": {
      "slot": 2,
      "well": [
        "E1"
      ]
    },
    "MIX": {
      "slot": 3,
      "well": [
        "A1"
      ]
    }
  }
