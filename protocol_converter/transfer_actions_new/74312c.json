{
  "description": "This protocol performs the transfer of buffer to various wells on a custom PCB board. It will delay for 1 minute and repeat the same transfers.\n\n\n\nP20 single-channel GEN2 electronic pipette",
  "tags": [
    "74312c.ot2.apiv2.py",
    "Sample Prep",
    "Plate Filling"
  ],
  "workflow": [
    {
      "action": "delay",
      "minutes": 1,
      "seconds": 0.0
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "trough",
        "targets": "Liquid_1",
        "asp_vol": 10.0,
        "dis_vol": 10.0,
        "asp_flow_rate": 7.559999999999953,
        "dis_flow_rate": 7.559999999999953,
        "tip_racks": [
          {
            "slot": 3,
            "type": "Opentrons OT-2 96 Tip Rack 20 uL",
            "well": "A1"
          },
          {
            "slot": 3,
            "type": "Opentrons OT-2 96 Tip Rack 20 uL",
            "well": "B1"
          }
        ]
      }
    }
  ],
  "reagent": {
    "Liquid_1": {
      "slot": 1,
      "well": [
        "K5"
      ],
      "labware": "PCB Board"
    },
    "trough": {
      "slot": 6,
      "well": [
        "A1"
      ],
      "labware": "Tetrahydrofuran"
    }
  }
}