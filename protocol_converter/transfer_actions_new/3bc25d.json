{
  "description": "This protocol automates the entire Oxford Nanopore sequencing kit SQK-RBK004 workflow. Input a variable number of samples (up to 12), and get out a pooled library. \n\n\n\nOpentrons P300-single channel electronic pipettes (GEN2)\nOpentrons P20-single channel electronic pipettes (GEN2)\nOpentrons 20ul Filter Tips\nOpentrons 200ul Filter Tips\nRapid Barcoding Kit (SQK-RBK004)\nFresh 70% Ethanol\nH2O\n1.5mL centrifuge tubes",
  "tags": [
    "NGS Library Prep",
    "Nanopore"
  ],
  "labware": [
    {
      "name": "Opentrons 24 Well Aluminum Block with NEST 0.5 mL Screwcap on Temperature Module GEN2 on 1",
      "slot": "1",
      "type": "lab_opentrons_24_aluminumblock_nest_0point5ml_screwcap"
    },
    {
      "name": "NEST 96 Well Plate 100 µL PCR Full Skirt on Magnetic Module GEN2 on 4",
      "slot": "4",
      "type": "lab_nest_96_wellplate_100ul_pcr_full_skirt"
    },
    {
      "name": "Opentrons 24 Tube Rack with Eppendorf 1.5 mL Safe-Lock Snapcap on 5",
      "slot": "5",
      "type": "lab_opentrons_24_tuberack_eppendorf_1point5ml_safelock_snapcap"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "NEST 96 Well Plate 100 µL PCR Full Skirt on Thermocycler Module on 7",
      "slot": "7",
      "type": "lab_nest_96_wellplate_100ul_pcr_full_skirt"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 9",
      "slot": "9",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
