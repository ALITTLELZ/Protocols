{
  "description": "This is a flexible protocol accommodating a wide range of PCR setups. Mastermix is transferred from a 2ml snapcap tube to clean PCR plate using a P20 GEN2 single-channel pipette. Then, a P20 GEN2 multi-channel pipette transfers eluates from RNA extraction to the PCR plate containing mastermix. Samples are transferred to their corresponding positions from plate to plate (A1 to A1, B1, to B1, etc.)",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "eluates from RNA extraction on 1",
      "slot": "1",
      "type": "lab_appliedbiosystemsmicroamp_96_aluminumblock_200ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 2",
      "slot": "2",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "final PCR plate on 4",
      "slot": "4",
      "type": "lab_appliedbiosystemsmicroamp_96_aluminumblock_200ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 5",
      "slot": "5",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "mastermix (tube A1) on Temperature Module GEN2 on 7",
      "slot": "7",
      "type": "lab_opentrons_24_aluminumblock_nest_2ml_snapcap"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "PRCXI_trash"
    }
  ],
