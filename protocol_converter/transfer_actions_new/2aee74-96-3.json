  "workflow": [
    {
      "action": "raw",
      "text": "Prepare and prime a 96.96 Dynamic ArrayTM  Integrated Fluidic Circuit (IFC) according to the manufacturer’s instructions. Briefly,inject one control line fluid syringe into each accumulator on the  chip, and then prime the chip on the IFC Controller for approximately 20 minutes."
    },
    {
      "action": "raw",
      "text": "Thaw the Primer Plate, vortex and spin  briefly."
    },
    {
      "action": "raw",
      "text": "P20 multi transfer will begin at column  1 of tiprack on slot 6."
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "det_mix",
        "targets": "strip",
        "asp_vol": 83.75,
        "dis_vol": 95.0,
        "asp_flow_rate": 92.86,
        "dis_flow_rate": 92.86,
        "tip_racks": {
          "slot": 10,
          "type": "Opentrons OT-2 96 Filter Tip Rack 200 uL",
          "well": "A1"
        }
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "det_mix",
        "targets": "det_mix",
        "asp_vol": 95.0,
        "dis_vol": 50.0,
        "asp_flow_rate": 92.86,
        "dis_flow_rate": 92.86
      }
    },
    {
