{
  "description": "Concentration normalization is a key component of many genomic and proteomic applications, such as NGS library prep. With this protocol, you can easily normalize the concentrations of samples in a 96-well plate from either 1.5ml snapcap tubes, or another 96-well plate. The transfers should be specified as an input .csv file formatted as shown here:\nSample number,Slot no number,Source well,Destination well,Start Concentration (ug/uL) Source,Final Concentraion (ug/ml) Destination,Sample volume (uL),Diluent Volume(ul),Total Volume(ul) Destination\n1,4,A1,A1,5,2,40,60,100.0\n2,4,C1,B1,3,2,67,33,100.0\n3,4,D1,C1,10,2,20,80,100.0\n4,4,E3,D1,20,2,10,90,100.0\nYou can also download and edit this template. Be sure to export the .xlsx format to .csv format before inputting as the input .csv file below!",
  "tags": [
    "Sample Prep",
    "Normalization"
  ],
  "labware": [
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 2",
      "slot": "2",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 3",
      "slot": "3",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "source plate on 5",
      "slot": "5",
      "type": "lab_nest_96_wellplate_100ul_pcr_full_skirt"
    },
    {
      "name": "end plate on 6",
      "slot": "6",
      "type": "lab_nest_96_wellplate_100ul_pcr_full_skirt"
    },
    {
      "name": "diluent (channel 1) on 9",
      "slot": "9",
      "type": "lab_nest_12_reservoir_15ml"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_1",
        "targets": "Liquid_2",
        "asp_vols": [
          30.0
        ],
        "dis_vols": [
          30.0
        ],
        "asp_flow_rates": [
          25.0
        ],
        "dis_flow_rates": [
          50.0
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "Liquid_3",
        "targets": "Liquid_2",
        "asp_vols": [
          40.0,
          33.5,
          33.5,
          20.0
        ],
        "dis_vols": [
          40.0,
          33.5,
          33.5,
          20.0
        ],
        "asp_flow_rates": [
          25.0,
          25.0,
          25.0,
          25.0
        ],
        "dis_flow_rates": [
          50.0,
          50.0,
          50.0,
          50.0
        ]
      }
    }
  ],
  "reagent": {
    "Liquid_3": {
      "slot": 5,
      "well": [
        "A1"
      ]
    },
    "Liquid_2": {
      "slot": 6,
      "well": [
        "C1"
      ]
    },
    "Liquid_1": {
      "slot": 9,
      "well": [
        "A1"
      ]
    }
  }
}