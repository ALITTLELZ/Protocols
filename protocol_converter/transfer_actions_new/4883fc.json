        "targets": "Liquid_2",
        "asp_vol": 37.57142857142857,
        "dis_vol": 37.57142857142857,
        "asp_flow_rate": 25.0,
        "dis_flow_rate": 50.0,
        "tip_racks": {
          "slot": 2,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A1"
        }
      }
    },
