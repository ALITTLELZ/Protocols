{
  "description": "This protocol performs a custom PCR prep by transferring samples, primers, BigDye, and water to a clean PCR plate. New tips are used for each transfer, both to avoid contamination and to accurately dispense small volumes (1-6µl). See below for deck and reagent setups.\nNote that the product of the number of samples multiplied by the number of primers cannot exceed 96, or an exception will be thrown.\nAn example of the transfer scheme is shown in the following schematic:",
  "tags": [
    "PCR",
    "PCR Prep"
  ],
  "labware": [
    {
      "name": "destination PCR plate on 1",
      "slot": "1",
      "type": "lab_thermofishermicroamp_96_aluminumblock_200ul"
    },
    {
      "name": "primer rack on 2",
      "slot": "2",
      "type": "lab_opentrons_24_aluminumblock_nest_1point5ml_snapcap"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 3",
      "slot": "3",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "source sample plate on 4",
      "slot": "4",
      "type": "lab_thermofishermicroamp_96_aluminumblock_200ul"
    },
    {
      "name": "reagent reservoir on 5",
      "slot": "5",
      "type": "lab_nest_12_reservoir_15ml"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 8",
      "slot": "8",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Opentrons 96 Tip Rack 20 µL on 9",
      "slot": "9",
      "type": "lab_opentrons_96_tiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "mm",
        "targets": "d_set",
        "asp_vols": [
          16.0
        ],
        "dis_vols": [
          16.0
        ],
        "asp_flow_rates": [
          7.6000000000000005
        ],
        "dis_flow_rates": [
          7.6000000000000005
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "sample_sources",
        "targets": "d_set",
        "asp_vols": [
          3.0
        ],
        "dis_vols": [
          3.0
        ],
        "asp_flow_rates": [
          7.6000000000000005
        ],
        "dis_flow_rates": [
          7.6000000000000005
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "primer_sources",
        "targets": "d_set",
        "asp_vols": [
          1.0
        ],
        "dis_vols": [
          1.0
        ],
        "asp_flow_rates": [
          7.560000000000001
        ],
        "dis_flow_rates": [
          7.560000000000001
        ]
      }
    }
  ],
  "reagent": {
    "d_set": {
      "slot": 1,
      "well": [
        "A1"
      ]
    },
    "primer_sources": {
      "slot": 2,
      "well": [
        "A2"
      ]
    },
    "sample_sources": {
      "slot": 4,
      "well": [
        "A1"
      ]
    },
    "mm": {
      "slot": 5,
      "well": [
        "A1"
      ]
    }
  }
}