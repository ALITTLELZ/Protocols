      "mix_time": 6
    },
    {
      "action": "raw",
      "text": "Seal plate with Microseal 'B' adhesive seal."
    },
    {
      "action": "raw",
      "text": "Incubate as follows."
    },
    {
      "action": "raw",
      "text": "[LS] Place on the thermal cycler and run the mRNA Denaturation program."
    },
    {
      "action": "raw",
      "text": "Each well contains 100 μl."
    },
    {
      "action": "raw",
      "text": "Incubate for 5 minutes on bench."
    },
    {
      "action": "raw",
      "text": "[LS] Centrifuge at 280 × g for 1 minute. Remove adhesive seal."
    },
    {
      "action": "raw",
      "text": "Place plate back on magnetic module on OT-2."
    },
