{
  "description": "This protocol performs a simple reagent addition for WISTD and water to up to 96 samples in a 96-flat well plate.",
  "tags": [
    "Sample Prep",
    "Plate Filling"
  ],
  "labware": [
    {
      "name": "Corning 96 Well Plate 360 µL Flat on 2",
      "slot": "2",
      "type": "lab_corning_96_wellplate_360ul_flat"
    },
    {
      "name": "Opentrons 96 Tip Rack 300 µL on 3",
      "slot": "3",
      "type": "lab_opentrons_96_tiprack_300ul"
    },
    {
      "name": "WISTD on 5",
      "slot": "5",
      "type": "lab_reagent_1_reservoir_130000ul"
    },
    {
      "name": "water on 6",
      "slot": "6",
      "type": "lab_reagent_1_reservoir_130000ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "mix",
      "vol": [
        250.0,
        250.0
      ],
      "position": {
        "well": "A1",
        "labware": "WISTD",
        "slot": 5
      },
      "flow_rate": [
        94.0,
        94.0
      ],
      "mix_time": 3
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "wistd",
        "targets": "samples",
        "asp_vol": 250.0,
        "dis_vol": 250.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": {
          "slot": 3,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A1"
        }
      }
    },
    {
      "action": "mix",
      "vol": [
        250.0,
        250.0
      ],
      "position": {
        "well": "A1",
        "labware": "water",
        "slot": 6
      },
      "flow_rate": [
        94.0,
        94.0
      ],
      "mix_time": 3
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "reagent",
        "targets": "samples",
        "asp_vol": 250.0,
        "dis_vol": 250.0,
        "asp_flow_rate": 94.0,
        "dis_flow_rate": 94.0,
        "tip_racks": {
          "slot": 3,
          "type": "Opentrons OT-2 96 Tip Rack 300 uL",
          "well": "A2"
        }
      }
    }
  ],
  "reagent": {
    "samples": {
      "slot": 2,
      "well": [
        "A4"
      ]
    },
    "wistd": {
      "slot": 5,
      "well": [
        "A1"
      ]
    },
    "reagent": {
      "slot": 6,
      "well": [
        "A1"
      ]
    }
  }
}