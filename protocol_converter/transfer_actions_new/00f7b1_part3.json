{
  "description": "This protocol is part 3 of a 10 part series. Please look at deck map and liquid legend below. This protocol adds the required reagents for the cDNA first strand synthesis",
  "tags": [
    "NGS Library Prep",
    "NEBNext® Ultra™ II Directional RNA Library Prep"
  ],
  "labware": [
    {
      "name": "Thermo Fisher 96 Well Plate 200 µL on Magnetic Module GEN2 on 1",
      "slot": "1",
      "type": "lab_thermofisher_96_wellplate_200ul"
    },
    {
      "name": "Opentrons 96 Well Aluminum Block with Generic PCR Strip 200 µL on Temperature Module GEN2 on 3",
      "slot": "3",
      "type": "lab_opentrons_96_aluminumblock_generic_pcr_strip_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 7",
      "slot": "7",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 8",
      "slot": "8",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "NEST 1 Well Reservoir 195 mL on 9",
      "slot": "9",
      "type": "lab_nest_1_reservoir_195ml"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 200 µL on 10",
      "slot": "10",
      "type": "lab_opentrons_96_filtertiprack_200ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 20 µL on 11",
      "slot": "11",
      "type": "lab_opentrons_96_filtertiprack_20ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "lab_opentrons_1_trash_1100ml_fixed"
    }
  ],
  "workflow": [
    {
      "action": "temperature",
      "target": 4.0
    },
    {
      "action": "mix",
      "vol": [
        10.0,
        10.0
      ],
      "position": {
        "well": "A1",
        "labware": "Thermo Fisher 96 Well Plate 200 uL on Magnetic Module GEN2",
        "slot": 1
      },
      "flow_rate": [
        7.6,
        7.6
      ],
      "mix_time": 6
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "enzyme_mix",
        "targets": "samples",
        "asp_vol": 5.0,
        "dis_vol": 5.0,
        "asp_flow_rate": 4.75,
        "dis_flow_rate": 4.75,
        "tip_racks": [
          {
            "slot": 8,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "A1"
          },
          {
            "slot": 8,
            "type": "Opentrons OT-2 96 Filter Tip Rack 20 uL",
            "well": "A2"
          }
        ]
      }
    }
  ],
  "reagent": {
    "samples": {
      "slot": 1,
      "well": [
        "A1"
      ]
    },
    "enzyme_mix": {
      "slot": 3,
      "well": [
        "A3"
      ]
    }
  }
}