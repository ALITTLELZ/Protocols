{
  "description": "This protocol performs a custom plate filling protocol from a 24-well source plate into one quadrant of a 96-well plate.",
  "tags": [
    "Sample Prep",
    "Plate Filling"
  ],
  "labware": [
    {
      "name": "source plate on 1",
      "slot": "1",
      "type": "lab_corning_24_wellplate_3point4ml_flat"
    },
    {
      "name": "destination plate 1 on 2",
      "slot": "2",
      "type": "lab_corning_96_wellplate_360ul_flat"
    },
    {
      "name": "destination plate 2 on 3",
      "slot": "3",
      "type": "lab_corning_96_wellplate_360ul_flat"
    },
    {
      "name": "Agilent 1 Well Reservoir 290 mL on 4",
      "slot": "4",
      "type": "lab_agilent_1_reservoir_290ml"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 1000 µL on 5",
      "slot": "5",
      "type": "lab_opentrons_96_filtertiprack_1000ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 1000 µL on 6",
      "slot": "6",
      "type": "lab_opentrons_96_filtertiprack_1000ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 1000 µL on 8",
      "slot": "8",
      "type": "lab_opentrons_96_filtertiprack_1000ul"
    },
    {
      "name": "Opentrons 96 Filter Tip Rack 1000 µL on 9",
      "slot": "9",
      "type": "lab_opentrons_96_filtertiprack_1000ul"
    },
    {
      "name": "Opentrons Fixed Trash on 12",
      "slot": "12",
      "type": "PRCXI_trash"
    }
  ],
  "workflow": [
    {
      "action": "transfer_liquid",
      "action_args": {
