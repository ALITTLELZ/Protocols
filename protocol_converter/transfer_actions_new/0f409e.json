        "targets": "dest_quadrant",
        "asp_vols": [
          100.0
        ],
        "dis_vols": [
          100.0
        ],
        "asp_flow_rates": [
          50.0
        ],
        "dis_flow_rates": [
          274.6999999999999
        ]
      }
    },
    {
      "action": "transfer_liquid",
      "action_args": {
        "sources": "buffer",
        "targets": "sources",
        "asp_vols": [
          800.0
        ],
        "dis_vols": [
          100.0
        ],
        "asp_flow_rates": [
          274.7
        ],
        "dis_flow_rates": [
          274.6999999999999
        ]
      }
    }
  ],
  "reagent": {
    "sources": {
      "slot": 1,
      "well": [
        "B6"
      ]
    },
    "dest_quadrant": {
      "slot": 3,
      "well": [
        "A3"
      ]
    },
    "buffer": {
      "slot": 4,
      "well": [
        "A1"
      ]
    }
  }
}